<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="stock_transactions_report"
              pageWidth="842" pageHeight="595" orientation="Landscape"
              columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">

    <parameter name="reportTitle" class="java.lang.String"/>
    <parameter name="filterInfo" class="java.lang.String"/>
    <parameter name="printedBy" class="java.lang.String"/>
    <parameter name="printedAt" class="java.lang.String"/>
    <parameter name="totalRecords" class="java.lang.Integer"/>

    <field name="stt" class="java.lang.Integer"/>
    <field name="transactionId" class="java.lang.String"/>
    <field name="typeLabel" class="java.lang.String"/>
    <field name="referenceId" class="java.lang.String"/>
    <field name="productName" class="java.lang.String"/>
    <field name="quantity" class="java.lang.String"/>
    <field name="createdByName" class="java.lang.String"/>
    <field name="createdAt" class="java.lang.String"/>
    <field name="note" class="java.lang.String"/>

    <title>
        <band height="90">
            <staticText>
                <reportElement x="0" y="0" width="300" height="20"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="11" isBold="true"/>
                </textElement>
                <text><![CDATA[HỆ THỐNG ACTIVITY HUB]]></text>
            </staticText>
            <textField>
                <reportElement x="0" y="24" width="802" height="26"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="18" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{reportTitle}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="52" width="802" height="16"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="10" isItalic="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{filterInfo}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="70" width="400" height="15"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA["Người lập: " + $P{printedBy}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="402" y="70" width="400" height="15"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA["Ngày xuất: " + $P{printedAt}]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <columnHeader>
        <band height="28">
            <staticText>
                <reportElement mode="Opaque" backcolor="#E9ECEF" x="0" y="0" width="40" height="28"/>
                <box><pen lineWidth="0.5" lineColor="#CCCCCC"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[STT]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" backcolor="#E9ECEF" x="40" y="0" width="100" height="28"/>
                <box><pen lineWidth="0.5" lineColor="#CCCCCC"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Mã Giao Dịch]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" backcolor="#E9ECEF" x="140" y="0" width="100" height="28"/>
                <box><pen lineWidth="0.5" lineColor="#CCCCCC"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Loại Biến Động]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" backcolor="#E9ECEF" x="240" y="0" width="182" height="28"/>
                <box><pen lineWidth="0.5" lineColor="#CCCCCC"/></box>
                <textElement textAlignment="Left" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[ Sản Phẩm]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" backcolor="#E9ECEF" x="422" y="0" width="70" height="28"/>
                <box><pen lineWidth="0.5" lineColor="#CCCCCC"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Thay Đổi]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" backcolor="#E9ECEF" x="492" y="0" width="100" height="28"/>
                <box><pen lineWidth="0.5" lineColor="#CCCCCC"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Người Tạo]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" backcolor="#E9ECEF" x="592" y="0" width="110" height="28"/>
                <box><pen lineWidth="0.5" lineColor="#CCCCCC"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Thời Gian]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" backcolor="#E9ECEF" x="702" y="0" width="100" height="28"/>
                <box><pen lineWidth="0.5" lineColor="#CCCCCC"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Ghi Chú]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="24">
            <textField isStretchWithOverflow="true" isBlankWhenNull="true">
                <reportElement stretchType="RelativeToTallestObject" x="0" y="0" width="40" height="24"/>
                <box><pen lineWidth="0.5" lineColor="#E0E0E0"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{stt}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true" isBlankWhenNull="true">
                <reportElement stretchType="RelativeToTallestObject" x="40" y="0" width="100" height="24"/>
                <box leftPadding="4"><pen lineWidth="0.5" lineColor="#E0E0E0"/></box>
                <textElement verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{transactionId}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true" isBlankWhenNull="true">
                <reportElement stretchType="RelativeToTallestObject" x="140" y="0" width="100" height="24"/>
                <box><pen lineWidth="0.5" lineColor="#E0E0E0"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{typeLabel}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true" isBlankWhenNull="true">
                <reportElement stretchType="RelativeToTallestObject" x="240" y="0" width="182" height="24"/>
                <box leftPadding="4"><pen lineWidth="0.5" lineColor="#E0E0E0"/></box>
                <textElement verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{productName}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true" isBlankWhenNull="true">
                <reportElement stretchType="RelativeToTallestObject" x="422" y="0" width="70" height="24"/>
                <box><pen lineWidth="0.5" lineColor="#E0E0E0"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="9" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{quantity}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true" isBlankWhenNull="true">
                <reportElement stretchType="RelativeToTallestObject" x="492" y="0" width="100" height="24"/>
                <box><pen lineWidth="0.5" lineColor="#E0E0E0"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{createdByName}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true" isBlankWhenNull="true">
                <reportElement stretchType="RelativeToTallestObject" x="592" y="0" width="110" height="24"/>
                <box><pen lineWidth="0.5" lineColor="#E0E0E0"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{createdAt}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true" isBlankWhenNull="true">
                <reportElement stretchType="RelativeToTallestObject" x="702" y="0" width="100" height="24"/>
                <box leftPadding="4"><pen lineWidth="0.5" lineColor="#E0E0E0"/></box>
                <textElement verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{note}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <pageFooter>
        <band height="24">
            <textField>
                <reportElement x="602" y="4" width="200" height="16"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA["Trang " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="4" width="300" height="16"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="8" isItalic="true"/>
                </textElement>
                <textFieldExpression><![CDATA["Tổng số bản ghi: " + $P{totalRecords}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>
</jasperReport>

